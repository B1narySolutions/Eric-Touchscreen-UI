<component>
    <view extends="lv_obj" width="992" height="280" scrollable="false">
        <style name="surface" />
        <parameter_dial name="comp_dial_0" x="20" y="48" width="310" title="Level" subject="comp_p0" format="%d%%" minimum="0" maximum="100" step="1" negative_step="-1" accent="#comp" control_id="3" />
        <parameter_dial name="comp_dial_1" x="342" y="48" width="310" title="Attack" subject="comp_p1" format="%d ms" minimum="1" maximum="100" step="1" negative_step="-1" accent="#comp" control_id="4" />
        <parameter_dial name="comp_dial_2" x="664" y="48" width="310" title="Sustain" subject="comp_p2" format="%d%%" minimum="0" maximum="100" step="1" negative_step="-1" accent="#comp" control_id="5" />
        <lv_label text="COMP" x="20" y="16" style_text_font="font_14" style_text_color="#comp" />
        <lv_label text="ACTIVE" align="top_right" x="-20" y="16" style_text_font="font_14" style_text_color="#muted">
            <bind_flag_if_not_eq subject="comp_enabled" ref_value="1" flag="hidden" />
        </lv_label>
        <lv_label text="BYPASSED" align="top_right" x="-20" y="16" style_text_font="font_14" style_text_color="#muted">
            <bind_flag_if_not_eq subject="comp_enabled" ref_value="0" flag="hidden" />
        </lv_label>
    </view>
</component>

