<component>
    <api>
        <prop name="title" type="string" default="Gain" />
        <prop name="subject" type="subject" default="amp_p0" />
        <prop name="format" type="string" default="%d%%" />
        <prop name="minimum" type="int" default="0" />
        <prop name="maximum" type="int" default="100" />
        <prop name="step" type="int" default="1" />
        <prop name="negative_step" type="int" default="-1" />
        <prop name="accent" type="color" default="#amber" />
        <prop name="control_id" type="int" default="1" />
    </api>
    <view extends="lv_obj" width="136" height="228" scrollable="false">
        <style name="surface" />
        <lv_label text="$title" x="0" y="0" style_text_font="font_16" style_text_color="#muted" align="top_mid" />
        <lv_arc name="dial" width="102" height="102" align="top_mid" y="30" rotation="135" bg_start_angle="0" bg_end_angle="270" min_value="$minimum" max_value="$maximum" bind_value="$subject" style_arc_color="#edge" style_arc_width="7" style_arc_color-indicator="$accent" style_arc_width-indicator="7" style_bg_color-knob="#ink" style_pad_all-knob="3">
            <subject_set_int_event subject="edited" value="1" trigger="value_changed" />
        </lv_arc>
        <lv_obj name="open_adjustment" align="top_mid" y="53" width="54" height="54" clickable="true" scrollable="false" style_bg_opa="0%" style_border_width="0" style_pad_all="0" style_radius="0">
            <subject_set_int_event subject="active_adjustment" value="$control_id" trigger="short_clicked" />
        </lv_obj>
        <lv_label name="readout" align="top_mid" y="136" width="112" height="36" style_text_align="center" bind_text="$subject" bind_text-fmt="$format" style_text_font="font_24" style_text_color="#ink" />
        <amp_button text="-" align="bottom_mid" x="-31" y="-4" width="52" height="52">
            <subject_increment_event subject="$subject" step="$negative_step" min_value="$minimum" max_value="$maximum" trigger="clicked" />
            <subject_set_int_event subject="edited" value="1" trigger="clicked" />
        </amp_button>
        <amp_button text="+" align="bottom_mid" x="31" y="-4" width="52" height="52">
            <subject_increment_event subject="$subject" step="$step" min_value="$minimum" max_value="$maximum" trigger="clicked" />
            <subject_set_int_event subject="edited" value="1" trigger="clicked" />
        </amp_button>
        <lv_obj style_bg_opa="0%" style_border_width="0" style_pad_all="0" style_radius="0" scrollable="false" name="open_readout" align="top_mid" y="129" width="100%" height="37" clickable="true">
            <subject_set_int_event subject="active_adjustment" value="$control_id" trigger="short_clicked" />
        </lv_obj>
    </view>
</component>
