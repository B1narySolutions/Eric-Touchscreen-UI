            <play_timeline_event trigger="clicked" target="self" timeline="slide" reverse="true" />
            <subject_set_int_event subject="sidebar_open" value="0" trigger="gesture" />
            <play_timeline_event trigger="gesture" target="self" timeline="slide" reverse="true" />
        </lv_obj>
        <amplifier_selector name="drawer" x="210" y="88" style_translate_y="-400" gesture_bubble="false">
            <subject_set_int_event subject="sidebar_open" value="0" trigger="gesture" />
            <play_timeline_event trigger="gesture" target="self" timeline="slide" reverse="true" />
            <amp_button text="X" x="364" y="2" width="44" height="42" style_bg_opa="0%" style_border_width="0">
                <subject_set_int_event subject="sidebar_open" value="0" trigger="clicked" />
                <play_timeline_event trigger="clicked" target="self" timeline="slide" reverse="true" />
            </amp_button>
        </amplifier_selector>
    </view>
</component>
